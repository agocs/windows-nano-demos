# EXPERIMENTAL - not wired into CI. Part of plans/go-cgo.md.
# Layers llvm-mingw (clang, ucrt, x86_64) onto an already built windows-nano-go image.
ARG GO_IMAGE=windows-nano-go:2025
FROM ${GO_IMAGE}

ENV LLVM_MINGW_VERSION=20261104 \
    TOOLCHAIN_DIR="C:\\Program Files\\llvm-mingw"

RUN curl -fLO https://github.com/mstorsjo/llvm-mingw/releases/download/%LLVM_MINGW_VERSION%/llvm-mingw-%LLVM_MINGW_VERSION%-ucrt-x86_64.zip && \
    tar -xf llvm-mingw-%LLVM_MINGW_VERSION%-ucrt-x86_64.zip -C "%ProgramFiles%" && \
    ren "%ProgramFiles%\llvm-mingw-%LLVM_MINGW_VERSION%-ucrt-x86_64" llvm-mingw && \
    del llvm-mingw-%LLVM_MINGW_VERSION%-ucrt-x86_64.zip

ENV CGO_ENABLED=1 CC=x86_64-w64-mingw32-clang CXX=x86_64-w64-mingw32-clang++
RUN setx PATH "%TOOLCHAIN_DIR%\bin;%GOROOT%\bin;%GOPATH%\bin;%MINGIT_DIR%\cmd;%MICROEDITOR_PATH%"
