# EXPERIMENTAL - not wired into CI. Part of plans/go-cgo.md.
# Layers WinLibs GCC (ucrt, x86_64, posix threads, seh) onto an already built windows-nano-go image.
# EXT=7z tests whether nanoserver's own tar can read the 7z (111 MB). EXT=zip is the 276 MB fallback.
ARG GO_IMAGE=windows-nano-go:2025
FROM ${GO_IMAGE}

ARG EXT=7z
ENV WINLIBS_RELEASE=16.2.0posix-23.1.3-14.0.0-ucrt-r3 \
    WINLIBS_FILE=winlibs-x86_64-posix-seh-gcc-16.2.0-mingw-w64ucrt-14.0.0-r3 \
    TOOLCHAIN_DIR="C:\\Program Files\\mingw64"

RUN curl -fLO https://github.com/brechtsanders/winlibs_mingw/releases/download/%WINLIBS_RELEASE%/%WINLIBS_FILE%.%EXT% && \
    tar -xf %WINLIBS_FILE%.%EXT% -C "%ProgramFiles%" && \
    del %WINLIBS_FILE%.%EXT%

ENV CGO_ENABLED=1 CC=gcc CXX=g++
RUN setx PATH "%TOOLCHAIN_DIR%\bin;%GOROOT%\bin;%GOPATH%\bin;%MINGIT_DIR%\cmd;%MICROEDITOR_PATH%"
